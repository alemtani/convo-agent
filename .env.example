# Anthropic (Claude conversation engine)
ANTHROPIC_API_KEY=sk-ant-...

# Azure Speech Services (STT + Pronunciation Assessment + TTS)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Shared passcode for the deployed app. Leave it unset locally — the gate stays
# off and you skip a login screen with no public URL to protect.
#
# REQUIRED ON ANY PUBLIC DEPLOY. Without it `/api/*` is open to whoever finds
# the hostname, and every call they make spends your Anthropic and Azure quota.
# Verify after deploying: `curl https://<host>/health` must report
# `"auth": "enabled"`. Rotating this value invalidates all existing sessions.
# APP_PASSCODE=

# How long a session cookie lasts. Default 30 days — it's your phone.
# SESSION_TTL_DAYS=30

# Partner-reply speech. The rate is a signed percentage handed to SSML; negative
# is slower, and the default -10% is there because the neural voice's native
# pace is unusable for a band-1–2 learner. Both are dials worth moving once real
# sessions say so.
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_RATE_PCT=-10

# A7 — feedback intake. A learner can file a bug, or contest one turn's grade,
# and it lands as a GitHub issue whose body is a replayable eval case. Unset
# means the feature is off: the route answers 503 and the app says so.
#
# The token is server-side and never reaches the client. A fine-grained personal
# access token with *only* "Issues: read and write" on the one repo is enough —
# this endpoint is unauthenticated wherever APP_PASSCODE is unset, so give it
# nothing it does not need.
# GITHUB_ISSUE_TOKEN=github_pat_...
# GITHUB_ISSUE_REPO=alemtani/convo-agent

# Labels to attach, comma-separated. Empty by default: the issues API *creates*
# a label that does not exist, so a typo here invents one in a public repo.
# GITHUB_ISSUE_LABELS=learner-report

# The rate limit is part of the feature, not a follow-up — this route writes to
# a public repo. Global, not per-IP: the tracker is what is being protected.
# FEEDBACK_RATE_LIMIT=4
# FEEDBACK_RATE_WINDOW_S=3600
# FEEDBACK_MAX_CHARS=8000
