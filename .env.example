# Anthropic (Claude conversation engine)
ANTHROPIC_API_KEY=sk-ant-...

# Azure Speech Services (STT + Pronunciation Assessment + TTS)
AZURE_SPEECH_KEY=your-azure-speech-key
AZURE_SPEECH_REGION=eastus

# Shared passcode for the deployed app. Leave it unset locally — the gate stays
# off and you skip a login screen with no public URL to protect.
#
# REQUIRED ON ANY PUBLIC DEPLOY. Without it `/api/*` is open to whoever finds
# the hostname, and every call they make spends your Anthropic and Azure quota.
# Verify after deploying: `curl https://<host>/health` must report
# `"auth": "enabled"`. Rotating this value invalidates all existing sessions.
# APP_PASSCODE=

# How long a session cookie lasts. Default 30 days — it's your phone.
# SESSION_TTL_DAYS=30
