# Coverage config for the backend service. The CI workflow runs the offline
# suite (live tests excluded by default) with `--cov-fail-under=95` so coverage
# can't silently regress as we ship. The threshold is set in the workflow, not
# here, so it's visible in CI logs.
[run]
source = backend
omit =
    backend/__init__.py
    backend/speech/__init__.py
    backend/workers/__init__.py

[report]
show_missing = True
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
